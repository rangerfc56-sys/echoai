OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Hinglish->English and OpenAI summaries use this model (e.g. gpt-5.5, gpt-5.4-mini, o3).
OPENAI_MODEL=gpt-5.5
# Optional: use Claude for translation only (requires anthropic package + ANTHROPIC_API_KEY).
# HINGLISH_TO_ENGLISH_BACKEND=anthropic
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
# ANTHROPIC_TRANSLATION_MODEL=claude-opus-4-6
# SUMMARY_BACKEND=openai  # choices: openai, biobert
# OPENAI_BASE_URL=https://api.openai.com/v1
ASR_MODEL_DIR=/home/surya/anuj/script2video/whisper-hindi-large-v2
# Optional comma-separated fallbacks used if ASR_MODEL_DIR is missing weights
# ASR_FALLBACK_MODEL_DIRS=/home/surya/anuj/script2video/whisper-hindi-large-v2,/home/surya/anuj/script2video/whisper-hindi-small
ASR_CHUNK_SECONDS=15
ASR_CHUNK_OVERLAP_SECONDS=2.0
CLINIC_WORKFLOW_PORT=7865
# FastAPI (app.py): comma-separated origins or * for allow all
# CORS_ORIGINS=*
# FASTAPI_PORT=8080
# Default clinical domain template under data/<name>.json
# MEDICAL_DOMAIN=general_medicine
# RunPod / Docker: mount models on a volume and point ASR here, e.g. /workspace/models/whisper-hindi2hinglish-prime
# ASR_MODEL_DIR=/workspace/models/whisper-hindi2hinglish-prime
# HF_HOME=/workspace/.cache/huggingface
# TRANSFORMERS_CACHE=/workspace/.cache/huggingface
# PORT=8080
